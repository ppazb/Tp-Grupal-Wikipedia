{
  "broker": {
    "host": "rabbitmq",
    "puerto": 5672,
    "usuario": "wikipedia",
    "contrasena": "desarrollo",
    "virtual_host": "/wikipedia",
    "latido_segundos": 60,
    "timeout_conexion_segundos": 10,
    "timeout_bloqueo_segundos": 30
  },
  "proceso": {
    "grupo": "frecuencias",
    "instancia": 0
  },
  "limites": {
    "mensajes_sin_confirmar": 4,
    "max_mensajes_por_cola": 1000,
    "max_bytes_por_mensaje": 65536
  },
  "grupos": {
    "ocurrencias": 2,
    "frecuencias": 2,
    "top_n": 1,
    "gateway_resultados": 1
  },
  "rutas": [
    {
      "nombre": "palabras",
      "origen": "ocurrencias",
      "destino": "frecuencias",
      "entrada": "palabras",
      "esquemas": [
        "PALABRA"
      ]
    },
    {
      "nombre": "conteos",
      "origen": "frecuencias",
      "destino": "top_n",
      "entrada": "conteos",
      "esquemas": [
        "CONTEO_PALABRA"
      ]
    },
    {
      "nombre": "resultado_q4",
      "origen": "top_n",
      "destino": "gateway_resultados",
      "entrada": "q4",
      "esquemas": [
        "CONTEO_PALABRA"
      ]
    },
    {
      "nombre": "errores_ocurrencias",
      "origen": "ocurrencias",
      "destino": "gateway_resultados",
      "entrada": "errores",
      "esquemas": [
        "ERROR_REGISTRO"
      ]
    },
    {
      "nombre": "errores_frecuencias",
      "origen": "frecuencias",
      "destino": "gateway_resultados",
      "entrada": "errores",
      "esquemas": [
        "ERROR_REGISTRO"
      ]
    },
    {
      "nombre": "errores_top_n",
      "origen": "top_n",
      "destino": "gateway_resultados",
      "entrada": "errores",
      "esquemas": [
        "ERROR_REGISTRO"
      ]
    }
  ]
}
