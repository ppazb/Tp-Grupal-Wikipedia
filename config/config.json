{
  "broker": {
    "host": "rabbitmq",
    "puerto": 5672,
    "usuario": "wikipedia",
    "contrasena": "desarrollo",
    "virtual_host": "/wikipedia",
    "latido_segundos": 60,
    "timeout_conexion_segundos": 10,
    "timeout_bloqueo_segundos": 30
